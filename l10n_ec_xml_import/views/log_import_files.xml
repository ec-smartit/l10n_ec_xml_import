<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="log_import_files_view_form" model="ir.ui.view">
        <field name="name">log.import.files.view.form</field>
        <field name="model">log.import.files</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="date" readonly="1"/>
                        <field name="import_type" readonly="1"/>
                    </group>
                </group>
                <group>
                    <field name="name" readonly="1"/>
                </group>
                <footer>
                    <button string="Ok" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="log_import_files_view_list" model="ir.ui.view">
        <field name="name">log.import.files.view.list</field>
        <field name="model">log.import.files</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="date"/>
                <field name="import_type"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="log_import_files_action" model="ir.actions.act_window">
        <field name="name">Log de Importación</field>
        <field name="res_model">log.import.files</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_log_import_files"
          name="Log"
          parent="menu_sri_received_root"
          action="log_import_files_action"
          groups="base.group_no_one"
          sequence="50"/>

</odoo>
